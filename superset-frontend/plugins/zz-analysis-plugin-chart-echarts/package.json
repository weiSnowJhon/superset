{
  "name": "zz-analysis-plugin-chart-echarts",
  "version": "0.1.0",
  "description": "Zz Analysis Plugin Chart Echarts",
  "sideEffects": false,
  "main": "lib/index.js",
  "module": "esm/index.js",
  "files": [
    "esm",
    "lib"
  ],
  "private": true,
  "scripts": {
    "build": "npm run build-cjs && npm run build-esm",
    "build-with-types": "npm run build && npm run ts-types",
    "build-cjs": "babel src --extensions \".ts,.tsx,.js,.jsx\" --copy-files --out-dir lib",
    "build-clean": "npm run clean && npm run build",
    "build-esm": "BABEL_OUTPUT=esm babel src --extensions \".ts,.tsx,.js,.jsx\" --copy-files --out-dir esm",
    "dev": "BABEL_OUTPUT=esm babel src --extensions \".ts,.tsx,.js,.jsx\" --watch --copy-files --out-dir esm",
    "prebuild": "rimraf {lib,esm,tsconfig.tsbuildinfo}",
    "ts-types": "tsc --build",
    "test": "jest"
  },
  "author": "My Name",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@types/react-redux": "^7.1.34",
    "d3-array": "^1.2.0",
    "dayjs": "^1.11.13",
    "lodash": "^4.17.21"
  },
  "peerDependencies": {
    "@airbnb/config-babel": "^2.0.1",
    "@superset-ui/chart-controls": "*",
    "@superset-ui/core": "*",
    "echarts": "*",
    "memoize-one": "*",
    "react": "^17.0.2"
  },
  "devDependencies": {
    "@babel/cli": "^7.16.0",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@types/jest": "^26.0.4",
    "babel-plugin-transform-dev": "^2.0.1",
    "babel-plugin-typescript-to-proptypes": "^2.1.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "rimraf": "^3.0.2",
    "typescript": "^4.1.2"
  }
}
